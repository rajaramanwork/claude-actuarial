                <mxCell id="zPrin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=2;fillColor=#ffffff;strokeColor=#666666;" value="Architecture Principles" vertex="1">
                    <mxGeometry height="300" width="430" x="1550" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="pText" parent="1" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;spacingLeft=4;" value="1. BU isolation: separate account, KMS keys, Snowflake roles and MCP scopes per BU.&lt;br&gt;2. Agents act only through MCP; no direct DB credentials on laptops.&lt;br&gt;3. Snowflake is the agent query surface; OLTP is read-mostly via MCP, written only through validated domain APIs.&lt;br&gt;4. Short-lived, Vault-issued credentials bound to the user&#39;s identity.&lt;br&gt;5. All LLM traffic through the LLM Gateway (quotas, PII filters, cost metering).&lt;br&gt;6. Every prompt, tool call and data change is logged and retained as model-risk evidence.&lt;br&gt;7. Human approval for writes, run submissions and published results." vertex="1">
                    <mxGeometry height="265" width="405" x="1565" y="820" as="geometry"/>
                </mxCell>
                <mxCell id="zLegend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=2;fillColor=#ffffff;strokeColor=#666666;" value="Legend" vertex="1">
