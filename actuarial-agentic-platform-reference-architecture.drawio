                <mxCell id="zOut" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=8;fontSize=13;arcSize=2;fillColor=#ffffff;strokeColor=#666666;" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Not used, and why&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Managed Agents:&lt;/b&gt; not available on Bedrock. Its default sandbox runs on Anthropic infrastructure, which conflicts with per-BU account and private-VPC isolation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Claude Platform on AWS:&lt;/b&gt; held in reserve for features Bedrock lacks. Anthropic operates it, so it needs its own data-governance review.&lt;br&gt;&lt;br&gt;&lt;b&gt;Claude Desktop:&lt;/b&gt; decision pending, so it is not shown here." vertex="1">
                    <mxGeometry height="245" width="580" x="1400" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="zLim" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=8;fontSize=13;arcSize=2;fillColor=#ffffff;strokeColor=#666666;" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Bedrock limits and platform answers&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Message Batches → own queue with Step Functions&lt;br&gt;• Hosted code execution → SageMaker or own compute&lt;br&gt;• MCP connector → agents call MCP servers from own code&lt;br&gt;• Server-side fallbacks → SDK client-side fallback&lt;br&gt;• Task budgets → token limits in the LLM Gateway&lt;br&gt;• Files API, API-side Agent Skills, web tools → not used&lt;br&gt;&lt;br&gt;&lt;i&gt;Based on the October 2026 Anthropic reference; confirm against live docs.&lt;/i&gt;" vertex="1">
                    <mxGeometry height="245" width="580" x="1400" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="zModel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=8;fontSize=13;arcSize=2;fillColor=#ffffff;strokeColor=#666666;" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Models&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Default:&lt;/b&gt; Claude Opus 5.5 for agents and hard coding work.&lt;br&gt;&lt;b&gt;Test:&lt;/b&gt; Sonnet 5.5 or Haiku 5.5 on high-volume steps, compared on cost per completed task.&lt;br&gt;&lt;b&gt;Confirm:&lt;/b&gt; availability in your Bedrock regions." vertex="1">
